{
  "name": "drawing-worlds",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.12.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "concurrently -k -n web,ws -c cyan,magenta \"next dev\" \"tsx watch server/index.ts\"",
    "dev:web": "next dev",
    "dev:ws": "tsx server/index.ts",
    "smoke:ws": "tsx server/smoke.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.11",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.29",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
